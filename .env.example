# ==============================================================================
# HomeCare Agentic Framework — Environment Configuration
# ==============================================================================

# ─── LLM Provider (OpenRouter BYOK) ───────────────────────────────────────────
# Required: Your OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default text generation model (e.g., anthropic/claude-sonnet-4, openai/gpt-4o)
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Vision model for UI wireframe & screenshot analysis
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4

# ─── Multi-Tier Model Routing ─────────────────────────────────────────────────
# High-cost / High-reasoning model for Architecture Analysis, Strategy & ADRs
MODEL_ARCHITECTURE=anthropic/claude-sonnet-4

# Medium / Low-cost model for Work Package code synthesis & test generation
# Examples: deepseek/deepseek-coder, meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-haiku
MODEL_CODE=deepseek/deepseek-coder

# Senior Architect reviewer persona model
MODEL_REVIEW=anthropic/claude-sonnet-4

# Optional: Granular per-node JSON model overrides
# NODE_MODELS={"execute_wave":"deepseek/deepseek-coder","review_architecture":"anthropic/claude-opus-4"}

# OpenRouter base API URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Local LLM Configuration (Optional: Ollama, vLLM, LM Studio) ──────────────
# When enabled, code generation work packages run locally with zero API token cost,
# while OpenRouter continues handling high-level architecture planning and reviews.
LOCAL_LLM_ENABLED=false
# Ollama: http://localhost:11434/v1 | vLLM: http://localhost:8000/v1 | LM Studio: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_CODE_MODEL=qwen2.5-coder:32b
LOCAL_LLM_FOR_CODE=true
LOCAL_LLM_TIMEOUT=300.0

# Token & temperature parameters
MAX_TOKENS=16384
TEMPERATURE=0.1

# ─── GitHub Configuration ─────────────────────────────────────────────────────
# Mode: "pat" or "github_app"
GITHUB_AUTH_MODE=pat

# For PAT authentication:
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# For GitHub App authentication:
GITHUB_APP_ID=0
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=0

# ─── Target Repository ────────────────────────────────────────────────────────
# Path to local repository working copy
REPO_PATH=c:/WorkingFolder/homecare-af

# GitHub repository URL (e.g. https://github.com/organization/repo)
REPO_URL=https://github.com/organization/homecare

# Default base branch for PRs
REPO_DEFAULT_BRANCH=main

# ─── Execution Strategy ───────────────────────────────────────────────────────
# Execution mode: "parallel" (concurrent within waves) or "sequential"
EXECUTION_MODE=parallel
MAX_PARALLEL_WORKERS=5
MAX_RETRIES=3

# Safety Guardrails & Resource Limits
MAX_ARCH_ITERATIONS=3
MAX_CLARIFICATION_ITERATIONS=2
MAX_LLM_CALLS_PER_RUN=60
# Cost-Saver Test Mode: stop immediately after intake & clarification Q&A
COST_SAVER_MODE=false

# Clarification mode: "cli" or "web"
CLARIFICATION_MODE=cli

# ─── Observability & Tracing (Langfuse) ────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-homecare-local
LANGFUSE_SECRET_KEY=sk-lf-homecare-local
# Set to http://localhost:13000 for local Docker self-hosting, or https://cloud.langfuse.com for cloud
LANGFUSE_HOST=http://localhost:13000

# Langfuse Security & Local Auto-Provisioning (used when self-hosting with docker compose)
# Generate a 64-character hex encryption key (e.g. openssl rand -hex 32)
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
SALT=
LANGFUSE_INIT_ORG_ID=homecare-org
LANGFUSE_INIT_ORG_NAME=HomeCare
LANGFUSE_INIT_PROJECT_ID=homecare
LANGFUSE_INIT_PROJECT_NAME=HomeCare
LANGFUSE_INIT_USER_EMAIL=admin@homecare.local
LANGFUSE_INIT_USER_NAME=HomeCare Admin
LANGFUSE_INIT_USER_PASSWORD=

# ─── UI & Server Settings ─────────────────────────────────────────────────────
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_AUTH_USER=
GRADIO_AUTH_PASSWORD=
# UI Theme: "crucible" (Executive Glassmorphism), "soft" (Gradio Soft Teal/Cyan), "default"
UI_THEME=crucible
LOG_LEVEL=INFO
LOG_FILE=logs/homecare-agent.log


